rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // التقارير والبيانات — قراءة مفتوحة، كتابة للمصادقين فقط
    match /reports/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // الوقود الوارد — قراءة مفتوحة، كتابة للمصادقين فقط
    match /fuelEntries/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // الإعدادات — قراءة مفتوحة، كتابة للمصادقين فقط
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // المحطات — قراءة مفتوحة، كتابة للمصادقين فقط
    match /stations/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // سجلات النشاط — للمصادقين فقط
    match /activityLogs/{docId} {
      allow read, write: if request.auth != null;
    }

    // تفضيلات المستخدم (الثيم وغيره) — للمصادقين فقط
    match /userPreferences/{docId} {
      allow read, write: if request.auth != null;
    }

    // المستخدمين والصلاحيات
    match /users/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
