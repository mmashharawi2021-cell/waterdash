rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Canonical roles are signed Firebase Auth custom claims. They are minted
    // only by Firebase Admin SDK/trusted server code, never by this browser.
    function signedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return signedIn() && request.auth.token.waterdashRole == role;
    }

    function isSuperAdmin() {
      return hasRole('superAdmin');
    }

    function isSupervisor() {
      return hasRole('supervisor');
    }

    function isDataEntry() {
      return hasRole('dataEntry');
    }

    function isViewer() {
      return hasRole('viewer');
    }

    function hasCanonicalRole() {
      return isSuperAdmin() || isSupervisor() || isDataEntry() || isViewer();
    }

    function canCreateOperationalData() {
      return isSuperAdmin() || isSupervisor() || isDataEntry();
    }

    function canEditOperationalData() {
      return isSuperAdmin() || isSupervisor();
    }

    function canDeleteOperationalData() {
      return isSuperAdmin();
    }

    function canManageSettings() {
      return isSuperAdmin() || isSupervisor();
    }

    // Legacy /users documents may contain browser-readable password hashes and
    // roles. They are migration-only data and cannot be used for authorization.
    // Even super-admin custom claims cannot change claims through Firestore.
    match /users/{userId} {
      allow read, create, update, delete: if false;
    }

    match /reports/{reportId} {
      allow read: if hasCanonicalRole();
      allow create: if canCreateOperationalData();
      allow update: if canEditOperationalData();
      allow delete: if canDeleteOperationalData();
    }

    match /fuelEntries/{docId} {
      allow read: if hasCanonicalRole();
      allow create: if canCreateOperationalData();
      allow update: if canEditOperationalData();
      allow delete: if canDeleteOperationalData();
    }

    match /settings/{docId} {
      allow read: if hasCanonicalRole();
      allow create, update, delete: if canManageSettings();
    }

    match /stations/{docId} {
      allow read: if hasCanonicalRole();
      allow create, update, delete: if canManageSettings();
    }

    // Activity logs are append-only. A regular user may append their action,
    // but cannot alter history; viewing audit history requires super-admin.
    match /activityLogs/{docId} {
      allow read: if isSuperAdmin();
      allow create: if hasCanonicalRole();
      allow update, delete: if false;
    }

    // Preferences are private to the authenticated Firebase Auth UID.
    match /userPreferences/{docId} {
      allow read, write: if signedIn() && request.auth.uid == docId;
    }
  }
}
