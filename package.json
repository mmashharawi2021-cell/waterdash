{
  "name": "geo-canvas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:verify": "npm run build && node test_build_artifact.cjs",
    "test:emulator": "firebase emulators:exec --config firebase.emulator.json --project waterdash-emulator --only auth,firestore \"node test_emulator_auth_admin.cjs && node test_emulator_rules.cjs\"",
    "test:emulator:browser": "firebase emulators:exec --config firebase.emulator.json --project waterdash-emulator --only auth,firestore \"node test_emulator_browser.cjs\"",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.21",
    "esri-leaflet": "^3.0.19",
    "firebase": "^12.13.0",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "leaflet-control-geocoder": "^3.3.1",
    "leaflet-draw": "^1.0.4",
    "leaflet-providers": "^3.0.0",
    "leaflet-routing-machine": "^3.2.12",
    "lucide-react": "^1.16.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.8.1",
    "shpjs": "^6.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-admin": "^14.3.0",
    "firebase-tools": "^15.28.1",
    "globals": "^17.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4"
  }
}
